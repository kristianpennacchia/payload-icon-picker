{
  "name": "payload-icon-picker",
  "version": "1.5.12-payload-v4.2",
  "description": "A dynamic icon picker field plugin for Payload CMS v4 supporting custom icon packs, searching, and custom SVG rendering.",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "icon-picker",
    "icons",
    "react-icons",
    "svg"
  ],
  "homepage": "https://github.com/kristianpennacchia/payload-icon-picker#readme",
  "bugs": {
    "url": "https://github.com/kristianpennacchia/payload-icon-picker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristianpennacchia/payload-icon-picker.git"
  },
  "license": "MIT",
  "author": "Vachagan <vach.mtx@gmail.com>",
  "contributors": [
    "Kristian Pennacchia"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "types": "./dist/exports/rsc.d.ts",
      "import": "./dist/exports/rsc.js",
      "default": "./dist/exports/rsc.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@payloadcms/ui": "4.0.0-beta.10",
    "payload": "4.0.0-beta.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "fuse.js": "^7.5.0",
    "html-react-parser": "^6.1.7"
  },
  "devDependencies": {
    "@payloadcms/ui": "4.0.0-beta.10",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "payload": "4.0.0-beta.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  }
}
